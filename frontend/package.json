{
  "name": "overwatch-queue-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main-electron.js",
  "homepage": "/",
  "scripts": {
    "dev": "npm run build:electron && concurrently \"vite\" \"cross-env NODE_ENV=development node scripts/run-electron.js . --dev\" --names \"Vite,Electron\" --prefix \"[{name}]\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "node scripts/run-electron.js .",
    "perf:startup": "npm run build && node scripts/measure-startup.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.525.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.66.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/node": "^22.18.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.7.1",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "build": {
    "appId": "com.overwatchqueuenotifier.app",
    "productName": "Overwatch Queue Notifier",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ]
  }
}
